# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analytics
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Error tracking
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# EAS
EXPO_TOKEN=your-expo-token

# OTTO — verificación IA de parkings (visión). Secret de edge function; NUNCA en cliente.
OTTO_PROVIDER=openai                 # "openai" (default) | "off" (bypass → aprueba todo, rollback)
OPENAI_API_KEY=your-openai-key       # proveedor de visión OpenAI-compatible
OTTO_VISION_MODEL=                   # modelo con visión (p.ej. gpt-5-mini); vacío = default del código
OTTO_VISION_URL=                     # opcional; default https://api.openai.com/v1/chat/completions

# OTTO — email SMTP (Otto envía y recibe avisos de dudosos/rechazados)
SMTP_HOST=smtp.tu-dominio.com
SMTP_PORT=465
SMTP_USER=otto@motociudad.com
SMTP_PASSWORD=your-smtp-password
OTTO_EMAIL_FROM=otto@motociudad.com
OTTO_EMAIL_TO=otto@motociudad.com
